{
  "name": "@guppy/models",
  "version": "1.0.0",
  "description": "Model catalog + selection: maps the pi-ai registry to Guppy's ModelConfig (provider/baseUrl/thinking passthrough)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
