    "@guppy/verification-engine": "workspace:*",
    "@guppy/workspace": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^22.0.0"
  },
  "type": "module"
