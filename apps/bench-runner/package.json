    "@guppy/context-engine": "workspace:*",
    "@guppy/verification-engine": "workspace:*",
    "@guppy/memory": "workspace:*",
    "@guppy/skills": "workspace:*",
    "@guppy/sleep-cycle": "workspace:*",
